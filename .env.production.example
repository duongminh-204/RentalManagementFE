# Biến VITE_* được nhúng vào bundle lúc BUILD (npm run build).
# Trên Render: đặt các biến này trong Dashboard → Environment TRƯỚC khi deploy.
#
# Copy giá trị mẫu bên dưới, thay URL bằng backend/frontend thực tế của bạn.

# Backend API (Render Web Service)
VITE_API_ORIGIN=https://rentalmanagementbe.onrender.com
VITE_API_BASE_URL=https://rentalmanagementbe.onrender.com/api

# Google OAuth — Client ID loại "Web application"
# Thêm URL frontend production vào Authorized JavaScript origins trên Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=730567914436-gosvf2jho38fh173a7hrin2kshfvb8fg.apps.googleusercontent.com
